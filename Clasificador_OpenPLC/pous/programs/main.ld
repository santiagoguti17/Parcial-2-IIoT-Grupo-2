PROGRAM main
  VAR
    Start_PB : BOOL AT %IX0.0; (* START NC + pull-up: TRUE = pulsado *)
    Stop_PB : BOOL AT %IX0.1; (* STOP NC + pull-up: TRUE = pulsado *)
    IN_EStop : BOOL AT %IX0.2; (* Final de carrera NC: TRUE = accionado *)
    IN_IR_Centro : BOOL AT %IX0.3; (* FC-51 centro: FALSE = detecta *)
    IN_IR_Local : BOOL AT %IX0.4; (* FC-51 local: FALSE = detecta *)
    IN_IR_Export : BOOL AT %IX0.5; (* FC-51 export: FALSE = detecta *)
    Motor_Derecha : BOOL AT %QX0.0; (* L298N IN1 -> EXPORT *)
    Motor_Izquierda : BOOL AT %QX0.1; (* L298N IN2 -> LOCAL *)
    Motor_Enable : BOOL AT %QX0.2; (* L298N ENA *)
    Piloto_Verde : BOOL AT %QX0.3; (* Sistema activo *)
    Piloto_Rojo : BOOL AT %QX0.4; (* Alarma / emergencia *)
    SystemActive : BOOL AT %QX1.0; (* Modbus coil 8 *)
    CycleActive : BOOL AT %QX1.1; (* Modbus coil 9 *)
    Listo_CV : BOOL AT %QX1.2; (* Modbus coil 10: Python clasifica cuando TRUE *)
    Alarm : BOOL AT %QX1.3; (* Modbus coil 11 *)
    EmergencyStop : BOOL AT %QX1.4; (* Modbus coil 12: E-stop enclavado por software *)
    MoveExport : BOOL AT %QX1.5; (* Modbus coil 13 *)
    MoveLocal : BOOL AT %QX1.6; (* Modbus coil 14 *)
    Sensor_Centro : BOOL AT %QX1.7; (* Modbus coil 15 *)
    CV_Result : INT AT %MW0; (* HR 32: 0 espera, 1 export, 2 local, 3 error *)
    CV_ID : INT AT %MW1; (* HR 33: Python lo cambia en cada clasificacion *)
    TotalExport : INT AT %MW2; (* HR 34: total mandarinas export *)
    CajasExport : INT AT %MW3; (* HR 35: cajas export completas *)
    MandarinasCajaExport : INT AT %MW4; (* HR 36: mandarinas en la caja actual 0-49 *)
    TotalLocal : INT AT %MW5; (* HR 37: total mandarinas local *)
    CajasLocal : INT AT %MW6; (* HR 38: cajas local completas *)
    MandarinasCajaLocal : INT AT %MW7; (* HR 39: mandarinas en la caja actual 0-49 *)
    Sensor_Local : BOOL;
    Sensor_Export : BOOL;
    Start_Pulso : BOOL;
    ResetAlarm : BOOL;
    Llegada_Export : BOOL;
    Llegada_Local : BOOL;
    FinCiclo : BOOL;
    CV_EsExport : BOOL;
    CV_EsLocal : BOOL;
    CV_EsError : BOOL;
    CV_Nuevo : BOOL;
    Alm_CVInvalido : BOOL;
    Alm_TimeoutCV : BOOL;
    Alm_TimeoutMov : BOOL;
    CV_ID_Ultimo : INT;
    R_TRIG_Start : R_TRIG;
    R_TRIG_Export : R_TRIG;
    R_TRIG_Local : R_TRIG;
    CTU_Export : CTU;
    CTU_Local : CTU;
    TON_CVTimeout : TON;
    TON_MoveTimeout : TON;
    TON_Descarga : TON;
    VelocidadObjetivo : INT AT %MW8 := 255; (* HR 40: velocidad final del motor 0-255 (sketch: velocidadObjetivo) *)
    VelocidadActual : INT AT %MW9; (* HR 41: velocidad aplicada al PWM 0-255 (sketch: velocidadActual) *)
    IntervaloPaso : INT := 15; (* ms entre incrementos de la rampa (sketch: intervaloPaso) *)
    Incremento : INT := 5; (* cuanto sube el PWM en cada paso (sketch: incremento) *)
    Rampa_Tiempo : TIME; (* tiempo desde que se habilito el puente H *)
    Rampa_ms : LINT; (* Rampa_Tiempo en milisegundos *)
    Rampa_msInt : INT; (* Rampa_ms como INT *)
    Rampa_Pasos : INT; (* pasos de rampa transcurridos *)
    Rampa_Valor : INT; (* pasos x Incremento *)
    TON_Rampa : TON; (* cuenta el tiempo de arranque *)
    PWM_Motor : PWM_L298N; (* salida PWM al ENA del L298N (GPIO21) *)
  END_VAR

